{
  "name": "fastify-boilerplate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "set NODE_ENV=development&&node index.js",
    "log": "node print-log.ts",
    "format": "prettier ./src index.js global-constants.js --write",
    "lint": "eslint ./src index.js global-constants.js --fix",
    "start:dev": "set NODE_ENV=development&&nodemon index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky && husky install",
    "lint-staged": "lint-staged --concurrent false",
    "migrate:make": "set NODE_ENV=development&&knex migrate:make",
    "migrate:latest": "set NODE_ENV=development&&knex migrate:latest",
    "migrate:list": "set NODE_ENV=development&&knex migrate:list",
    "migrate:rollback": "set NODE_ENV=development&&knex migrate:rollback",
    "migrate:down": "set NODE_ENV=development&&knex migrate:down",
    "seed:make": "set NODE_ENV=development&&knex seed:make",
    "seed:run": "set NODE_ENV=development&&knex seed:run",
    "script:run": "set NODE_ENV=development&&node db/script/run-script.js"
  },
  "imports": {
    "#repository/*": "./src/repository/*",
    "#utilities/*": "./src/utilities/*"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.678.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/env": "^4.4.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/redis": "^6.2.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "github:AsadGG/fastify-swagger-ui",
    "@lukeed/ms": "^2.0.2",
    "@sendgrid/mail": "^8.1.4",
    "@sinclair/typebox": "^0.33.17",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-bcrypt": "^1.0.1",
    "fastify-plugin": "^4.5.1",
    "knex": "^3.1.0",
    "lodash": "^4.17.21",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "pino-roll": "^2.1.0",
    "puppeteer": "^23.6.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "glob": "^11.0.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "pretty-bytes": "^6.1.1"
  }
}
